modules = ["php", "php-8.2", "python-3.11", "python3", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["php82Extensions.zip", "imagemagick", "php82Extensions.imap", "mysql80", "php82Extensions.pdo_pgsql", "php82Extensions.pgsql", "actionlint"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PHP Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Push"

[[workflows.workflow]]
name = "PHP Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:5000 -t ."
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Push"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = """
set -eu
: \"${MY_PERSONAL_KEY:?MY_PERSONAL_KEY is not configured}\"
export GIT_TERMINAL_PROMPT=0
git remote set-url origin https://github.com/salesmanno/www.git
git -c credential.helper= -c 'credential.helper=!f() { if [ \"$1\" = get ]; then printf \"%s
\" \"username=x-access-token\" \"password=$MY_PERSONAL_KEY\"; fi; }; f' push -u origin main"""

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
