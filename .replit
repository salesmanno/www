modules = ["php", "php-8.2", "python-3.11", "python3", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["php82Extensions.zip", "imagemagick", "php82Extensions.imap", "mysql80", "php82Extensions.pdo_pgsql", "php82Extensions.pgsql", "actionlint"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PHP Server"

[[workflows.workflow]]
name = "PHP Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:5000 -t ."
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Push"
mode = "sequential"
author = 15553469

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git init && git config user.email \"replit@example.com\" && git config user.name \"Replit Workflow\" && git remote remove origin 2>/dev/null; git remote add origin https://${MY_PERSONAL_TOKEN}@${TARGET_REPO} && git add . && git commit -m \"Lagret før pull\" --allow-empty && git pull origin main --rebase --allow-unrelated-histories -X theirs && git push -u origin main"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
