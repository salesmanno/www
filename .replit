modules = ["php", "php-8.2", "python-3.11", "python3", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["php82Extensions.zip", "imagemagick", "php82Extensions.imap", "mysql80", "php82Extensions.pdo_pgsql", "php82Extensions.pgsql", "actionlint"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PHP Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Publish to salesman.no"


[[workflows.workflow]]
name = "PHP Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:5000 -t ."
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Publish to salesman.no"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .github/scripts/publish_from_replit.sh"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
