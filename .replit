modules = ["php", "php-8.2", "postgresql-16", "python-3.11", "python3", "nodejs-20"]

[nix]
channel = "stable-24_05"
packages = ["php82Extensions.zip", "imagemagick", "php82Extensions.imap", "mysql80", "php82Extensions.pdo_pgsql", "php82Extensions.pgsql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PHP Server"

[[workflows.workflow]]
name = "PHP Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:5000 -t ."
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33125
externalPort = 3000

[[ports]]
localPort = 33523
externalPort = 3001

[[ports]]
localPort = 36961
externalPort = 5000

[[ports]]
localPort = 41747
externalPort = 3002

[[ports]]
localPort = 42363
externalPort = 5173

[[ports]]
localPort = 43693
externalPort = 6000

[[ports]]
localPort = 45479
externalPort = 3003

[[ports]]
localPort = 45729
externalPort = 4200

[agent]
expertMode = true
